---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { Image } from "astro:assets";
import type { MarkdownInstance } from "astro";
import { loadImage } from "../../scripts/resolveImage";

interface Frontmatter {
  title: string;
  date: string;
  description: string;
  image?: string;
}

const subpages = Object.values(
  import.meta.glob<MarkdownInstance<Frontmatter>>("./*.md*", { eager: true }),
).sort((a, b) => b.frontmatter.date.localeCompare(a.frontmatter.date));

const posts = await Promise.all(
  subpages.map(async ({ url, frontmatter }) => ({
    url,
    ...frontmatter,
    image: frontmatter.image && (await loadImage(frontmatter.image)),
  })),
);
const firstImage = posts.findIndex((post) => post.image);
// column count changes at 312n + 24 px (18rem cards, 24px gap, 2×32px main margin); 4+ columns stay ≤ ~24rem
const sizes =
  "(min-width: 1272px) 24rem, (min-width: 960px) 33vw, (min-width: 648px) 50vw, calc(100vw - 64px)";
---

<BaseLayout title="blog">
  <h1>Blog aka. the Tinker-Diary</h1>
  <p>I shall write stuff and you shall read</p>
  <ul class="posts">
    {
      posts.map((post, i) => (
        <li>
          <a href={post.url} class="card">
            {post.image ? (
              <Image
                src={post.image}
                alt=""
                widths={[320, 640, 960, 1280]}
                sizes={sizes}
                loading={i === firstImage ? "eager" : "lazy"}
                fetchpriority={i === firstImage ? "high" : "auto"}
              />
            ) : (
              <p class="description">{post.description}</p>
            )}
            <div class="caption">
              <time datetime={post.date}>
                {new Date(post.date).toLocaleDateString("en-GB", {
                  dateStyle: "medium",
                })}
              </time>
              <h2>{post.title}</h2>
            </div>
          </a>
        </li>
      ))
    }
  </ul>
</BaseLayout>

<style>
  .posts {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(18rem, 100%), 1fr));
    gap: var(--size-24);
    padding: 0;
    list-style: none;
  }

  .card {
    position: relative;
    display: grid;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: var(--size-8);
    background-color: var(--surface0);
    box-shadow: 0 var(--size-4) var(--size-16) var(--crust);
    color: var(--text-color);
    text-decoration: none;
    transition:
      translate 0.2s ease-out,
      box-shadow 0.2s ease-out;

    &:hover,
    &:focus-visible {
      translate: 0 calc(-1 * var(--size-4));
      box-shadow: 0 var(--size-8) var(--size-24) var(--crust);
    }

    img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      border-radius: 0;
    }
  }

  .description {
    margin: 0;
    padding: var(--size-16);
    font-size: var(--font-size-16);
    color: var(--subtext0);
  }

  .caption {
    position: absolute;
    inset: auto 0 0;
    padding: var(--size-48) var(--size-16) var(--size-12);
    /* fixed dark scrim so white text stays readable on any photo, in both themes */
    background: linear-gradient(to top, oklch(0% 0 0 / 0.8), transparent);
    color: white;

    time {
      font-size: var(--font-size-14);
      opacity: 0.85;
    }

    h2 {
      margin: 0;
      font-size: var(--font-size-20);
      line-height: 1.2;
    }
  }

  .card:not(:has(img)) .caption {
    background: none;
    color: var(--text-color);
  }
</style>
