---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  href: string;
  title: string;
  /** local image metadata or a remote URL (remote ones need `image.domains` in astro.config) */
  image?: ImageMetadata | string;
  /** shown in the card body when there is no image */
  description?: string;
  /** the first card with an image should load eagerly (LCP) */
  eager?: boolean;
}

const { href, title, image, description, eager = false } = Astro.props;

// column count changes at 312n + 24 px (18rem cards, 24px gap, 2×32px main margin); 4+ columns stay ≤ ~24rem
const sizes =
  "(min-width: 1272px) 24rem, (min-width: 960px) 33vw, (min-width: 648px) 50vw, calc(100vw - 64px)";
---

<li>
  <a href={href} class="card">
    {
      image ? (
        <Image
          src={image}
          alt=""
          inferSize={typeof image === "string"}
          widths={[320, 640, 960, 1280]}
          sizes={sizes}
          loading={eager ? "eager" : "lazy"}
          fetchpriority={eager ? "high" : "auto"}
        />
      ) : (
        <p class="description">{description}</p>
      )
    }
    <div class="caption">
      <div class="meta"><slot /></div>
      <h2>{title}</h2>
    </div>
  </a>
</li>

<style>
  .card {
    position: relative;
    display: grid;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: var(--size-8);
    background-color: var(--surface0);
    box-shadow: 0 var(--size-4) var(--size-16) var(--crust);
    color: var(--text-color);
    text-decoration: none;
    transition:
      translate 0.2s ease-out,
      box-shadow 0.2s ease-out;

    &:hover,
    &:focus-visible {
      translate: 0 calc(-1 * var(--size-4));
      box-shadow: 0 var(--size-8) var(--size-24) var(--crust);
    }

    img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      border-radius: 0;
    }
  }

  .description {
    margin: 0;
    padding: var(--size-16);
    font-size: var(--font-size-16);
    color: var(--subtext0);
  }

  .caption {
    position: absolute;
    inset: auto 0 0;
    padding: var(--size-48) var(--size-16) var(--size-12);
    /* fixed dark scrim so white text stays readable on any photo, in both themes */
    background: linear-gradient(to top, oklch(0% 0 0 / 0.8), transparent);
    color: white;

    .meta {
      font-size: var(--font-size-14);
      opacity: 0.85;
    }

    h2 {
      margin: 0;
      font-size: var(--font-size-20);
      line-height: 1.2;
    }
  }

  .card:not(:has(img)) .caption {
    background: none;
    color: var(--text-color);
  }
</style>
