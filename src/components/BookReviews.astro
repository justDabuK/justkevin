---
// Fetches book reviews from a BookWyrm ActivityPub outbox at *build time*
// and renders the ones published within a [start, end] date range.
// (The RSS feed only carries the latest ~10 reviews, the outbox has all of them.)
//
// Outbox pages are newest first; reviews are items of type "Article":
//   name: 'Review of "Book" (N stars): Review headline'
//   content: HTML review body
//   published: ISO date
//   id: review URL (redirects to the permalink)
//   attachment[0]: { url, name } of the book cover

interface Props {
  /** Inclusive start of the range. Date or any string `new Date()` accepts (e.g. "2026-06-01"). */
  start: string | Date;
  /** Inclusive end of the range. A date-only string covers the whole day. */
  end: string | Date;
  /** Override the outbox URL if needed. */
  outboxUrl?: string;
}

const {
  start,
  end,
  outboxUrl = "https://wyrms.de/user/justkevin/outbox?page=1",
} = Astro.props;

const startDate = new Date(start);
const endDate = new Date(end);
// Make the range inclusive of the whole end day when no explicit time was given.
endDate.setHours(23, 59, 59, 999);

type Review = {
  title: string;
  descriptionHtml: string;
  pubDate: Date;
  link: string;
  cover?: { url: string; name: string };
};

type OutboxItem = {
  type: string;
  id: string;
  name?: string;
  content?: string;
  published: string;
  attachment?: { url: string; name: string }[];
};

let reviews: Review[] = [];

try {
  let pageUrl: string | undefined = outboxUrl;
  // walk pages until we're past the start of the range (or out of pages)
  while (pageUrl) {
    const response = await fetch(pageUrl, {
      headers: { Accept: "application/activity+json" },
    });
    if (!response.ok) throw new Error(`HTTP ${response.status}`);
    const page: { orderedItems?: OutboxItem[]; next?: string } =
      await response.json();
    const items = page.orderedItems ?? [];

    for (const item of items) {
      const pubDate = new Date(item.published);
      if (
        item.type === "Article" &&
        item.content?.trim() &&
        pubDate >= startDate &&
        pubDate <= endDate
      ) {
        reviews.push({
          title: item.name ?? "",
          descriptionHtml: item.content,
          pubDate,
          link: item.id,
          cover: item.attachment?.[0],
        });
      }
    }

    const oldest = items.at(-1);
    pageUrl =
      oldest && new Date(oldest.published) >= startDate ? page.next : undefined;
  }
  reviews.sort((a, b) => a.pubDate.getTime() - b.pubDate.getTime());
} catch (error) {
  // Don't fail the whole build if the outbox is unreachable — just log and render nothing.
  console.error(`[BookReviews] Could not load outbox ${outboxUrl}:`, error);
}
---

<div class="book-reviews">
  {
    reviews.map((review) => (
      <article class="book-review">
        {review.cover && <img src={review.cover.url} alt={review.cover.name} />}
        <div>
          <h3>
            <a href={review.link}>{review.title}</a>
          </h3>
          <div set:html={review.descriptionHtml} />
        </div>
      </article>
    ))
  }
</div>

<style>
  .book-reviews {
    display: grid;
    grid-template-columns: 120px 1fr;
    gap: var(--size-32) var(--size-16);
  }

  /* each entry is one row of the outer grid, so all covers/texts share the same columns */
  .book-review {
    display: grid;
    grid-column: 1 / -1;
    grid-template-columns: subgrid;
    align-items: start;

    img {
      width: 100%;
      align-self: center;
      height: auto;
    }

    h3 {
      margin-top: 0;
    }

    /* no cover: text takes both columns */
    > div:only-child {
      grid-column: 1 / -1;
    }
  }

  .book-reviews {
    container-type: inline-size;
  }

  /* narrow: cover becomes a thumbnail next to the title, text goes full width below */
  @container (width < 30rem) {
    .book-review {
      grid-template-columns: 64px 1fr;
      grid-template-areas:
        "cover title"
        "text text";
      column-gap: var(--size-12);

      /* lets h3 and text be placed in the article's grid directly */
      > div {
        display: contents;
      }

      img {
        grid-area: cover;
      }

      h3 {
        grid-area: title;
        margin-bottom: 0;
        align-self: center;
      }

      > div > div {
        grid-area: text;
      }

      > div:only-child > h3 {
        grid-column: 1 / -1;
      }
    }
  }
</style>
